<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+: hand the cold-start splash over to the platform so the brand
         mark shows immediately, with no flash before Compose draws.
         The AnimatedIcon is masked to a circle, so it must be the WORDMARK-FREE
         head-only mark — the full koalas_logo lockup would get its "KOLAS"
         lettering clipped. The Compose splash shows the full lockup instead. -->
    <style name="Theme.Kolas.Splash" parent="Theme.Kolas">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_background</item>
    </style>
</resources>
